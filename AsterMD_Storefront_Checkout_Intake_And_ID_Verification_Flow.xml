<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AsterMD Complete Order and Patient Verification Flow" parallel="false" preserve-order="true">

    <test name="Step 1 - Storefront Product Selection and Checkout" preserve-order="true">
        <classes>
            <class name="Store.Frontend_Store_Front">
                <methods>
                    <include name="Product_Choose"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Step 2 - Patient Portal Intake Form Submission" preserve-order="true">
        <classes>
            <class name="Patient_Portal.Pateint_Portal">
                <methods>
                    <include name="Intake_form_filling"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Step 3 - Admin Intake Form Check" preserve-order="true">
        <classes>
            <class name="AsterMD.Project.AsterMD.Treatment_Module">
                <methods>
                    <include name="Intake_form_Admin_Check"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Step 4 - Patient Portal ID Verification" preserve-order="true">
        <classes>
            <class name="Patient_Portal.Pateint_Portal">
                <methods>
                    <include name="Veirfy_Id_form_filling"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Step 5 - Admin Treatment Patient Details Verification" preserve-order="true">
        <classes>
            <class name="AsterMD.Project.AsterMD.Treatment_Module">
                <methods>
                    <include name="Treatment_Patient_Details_Check"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>