<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AsterMD Complete Order and Patient Verification Flow" parallel="false" preserve-order="true">

    <!-- Step 1 - Storefront product selection and checkout -->
    <test name="Step 1 - Storefront Product Selection and Checkout" preserve-order="true">
        <classes>
            <class name="Store.Frontend_Store_Front">
                <methods>
                    <include name="Product_Choose"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Step 2 - Patient portal intake and ID verification in one invocation -->
    <test name="Step 2 - Patient Portal Intake and ID Verification" preserve-order="true">
        <classes>
            <class name="Patient_Portal.Pateint_Portal">
                <methods>
                    <include name="Intake_form_filling"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Step 3 - Admin inspection of the submitted intake and ID forms -->
    <test name="Step 3 - Admin Intake and ID Form Check" preserve-order="true">
        <classes>
            <class name="AsterMD.Project.AsterMD.Treatment_Module">
                <methods>
                    <include name="Intake_form_Admin_Check"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Step 4 - Admin treatment patient details and Beluga authorization -->
    <test name="Step 4 - Admin Treatment Patient Details Verification" preserve-order="true">
        <classes>
            <class name="AsterMD.Project.AsterMD.Treatment_Module">
                <methods>
                    <include name="Treatment_Patient_Details_Check"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>